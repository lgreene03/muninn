<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.muninn</groupId>
    <artifactId>muninn</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Muninn</name>
    <description>Event-native research infrastructure platform</description>

    <properties>
        <java.version>21</java.version>
        <duckdb.version>1.5.5.0</duckdb.version>
        <parquet.version>1.18.1</parquet.version>
        <hadoop.version>3.5.0</hadoop.version>
        <awssdk.version>2.51.2</awssdk.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <archunit.version>1.5.0</archunit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <trino.version>483</trino.version>
        <iceberg.version>1.11.0</iceberg.version>
    </properties>

    <dependencyManagement>
        <!--
          CVE-remediation pins (2026-09 dependency-check triage). These override
          versions pulled in transitively by hadoop/iceberg/spring-kafka that would
          otherwise resolve to a release with a known CVE >= 7. See SECURITY.md and
          dependency-check-suppressions.xml for the fuller audit trail, including the
          items that could NOT be fixed this way (shaded jars, EOL branches).
        -->
        <dependencies>
            <!--
              Netty: import the BOM instead of pinning ~30 individual netty-* artifacts.
              hadoop-common declares netty 4.2.15.Final transitively; without this pin the
              resolved graph happens to converge on 4.2.17.Final today (software.amazon.awssdk:
              netty-nio-client declares a newer netty and sits closer to the dependency root),
              but that is an accident of Maven's nearest-wins mediation, not a guarantee — a
              future change anywhere in the graph could silently regress it back to hadoop's
              4.2.15.Final. 4.2.18.Final is the latest stable release (2026-09-09) and fixes
              every netty-* CVE from the 2026-09-11 scan (CVE-2026-56820, 55851, 56745, 59901,
              56817, 44891, 55831, 55833, 56816, 56819, 56821, 56822, 59899, 59900, 56746,
              59920, 59921, 59898, 62380, 59919 — all fixed at or before 4.2.17.Final;
              4.2.18.Final additionally closes a further http/http2/http3/mqtt/redis/smtp/
              ssl-ocsp batch disclosed alongside it).
            -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.18.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              commons-configuration2: hadoop-common pulls 2.10.1 transitively.
              CVE-2026-45205 (uncontrolled recursion / StackOverflowError on crafted
              config input) is fixed in 2.15.0; pin to the latest stable patch release.
            -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-configuration2</artifactId>
                <version>2.15.1</version>
            </dependency>

            <!--
              kafka-clients / kafka-server / kafka-server-common: spring-kafka 4.1.1 manages
              4.2.1. CVE-2026-41115 (CONSUMER_GROUP_DESCRIBE checks the DESCRIBE ACL operation
              instead of READ) lives in the broker/authorizer code, not in kafka-clients
              itself — Muninn only ever runs as a Kafka *client* against Redpanda, never an
              Apache Kafka broker — but kafka-server / kafka-server-common (test-scope only,
              pulled in by spring-kafka-test's embedded broker) do contain the affected
              authorizer code. Fixed in 4.3.1; pinning all three keeps the client and the
              test-only embedded broker on the same, patched line.
            -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>4.3.1</version>
            </dependency>
            <!--
              The "test" classifier is a distinct Maven coordinate from the plain jar above
              and needs its own managed entry — otherwise it stays on whatever version
              spring-kafka-test's embedded-broker chain declares (4.2.1).
            -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>4.3.1</version>
                <classifier>test</classifier>
            </dependency>
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-server</artifactId>
                <version>4.3.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-server-common</artifactId>
                <version>4.3.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-server-common</artifactId>
                <version>4.3.1</version>
                <classifier>test</classifier>
            </dependency>

            <!--
              httpclient5 / httpcore5 / httpcore5-h2: pulled in transitively by iceberg-core.
              The graph already resolves to the versions below (the latest stable releases as
              of 2026-09), which close CVE-2026-71290 / CVE-2026-64607 (httpclient5) and
              CVE-2026-54399 / CVE-2026-54428 (httpcore5 / httpcore5-h2). Pinned explicitly so
              a future iceberg-core bump can't silently regress the resolved version back down.
            -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>5.6.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>5.4.3</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>5.4.3</version>
            </dependency>

            <!--
              2026-09-11 (post-merge follow-up, verified against a real dependency-check run,
              GH Actions run 34651381704): Spring Boot 4.1.1 manages tomcat-embed-core /
              tomcat-embed-websocket at 11.0.24, which carries 9 CVEs >= 7 (CVSS up to 9.8 —
              the most severe findings in the whole report) plus 2 below the gate threshold.
              This is Spring's own embedded HTTP server — very much live code, not a dead
              path. Spring Boot has not yet cut a patch release managing a newer Tomcat
              (4.1.1 is still the latest spring-boot-starter-parent; 4.2.0-M1 is a milestone,
              not appropriate to pin to), so override directly. All are fixed in Tomcat
              11.0.25 (released 2026-08-18): CVE-2026-65637, 65905, 65182, 68525, 65183,
              66422, 68569, 65927, 68763, 73180, 66299.
            -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>11.0.25</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>11.0.25</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-zipkin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- springdoc 3.x targets Spring Boot 4 / Spring Framework 7; 2.x is Boot 3 only. -->
            <version>3.1.0</version>
        </dependency>

        <!-- Kafka / Redpanda -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Spring Boot 4.0 extracted Kafka auto-configuration (KafkaProperties,
             KafkaConnectionDetails) out of spring-boot-autoconfigure into this
             dedicated module. spring-kafka alone no longer brings it in. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- DuckDB -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>${duckdb.version}</version>
        </dependency>

        <!-- Trino JDBC — production-reference query backend. See ADR-0006.
             The driver is sizeable; production deploys override the default
             muninn.query.backend=duckdb to activate the Trino path. -->
        <dependency>
            <groupId>io.trino</groupId>
            <artifactId>trino-jdbc</artifactId>
            <version>${trino.version}</version>
        </dependency>

        <!-- Apache Iceberg — production-reference archival sink (ADR-0007).
             Inactive at runtime unless muninn.archival.sink=iceberg. The
             aws-bundle ships shaded AWS SDK clients so we don't fight Hadoop
             transitives. -->
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-core</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-data</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-parquet</artifactId>
            <version>${iceberg.version}</version>
        </dependency>
        <!-- iceberg-aws exposes the GlueCatalog + S3FileIO classes for compile-time
             access. We already pull software.amazon.awssdk:s3 above; iceberg-aws
             brings the matching glue/sts/kms clients transitively. -->
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-aws</artifactId>
            <version>${iceberg.version}</version>
        </dependency>

        <!-- Parquet -->
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-avro</artifactId>
            <version>${parquet.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <!--
                  jetty-webapp / jetty-servlet: hadoop-common pulls these in for its embedded
                  HttpServer2 admin UI (NameNode/DataNode/ResourceManager web pages). Muninn
                  never starts a Hadoop daemon or its web UI — hadoop-common is used purely as
                  a FileSystem/Configuration library for Parquet/Iceberg I/O against S3 — so
                  HttpServer2 is never instantiated and these classes are dead weight on our
                  classpath. They also sit on the EOL Jetty 9.4 branch: 9.4.58.v20250814 is the
                  last version Eclipse ever published there, so there is no patched 9.4.x to
                  pin to. They carry CVE-2026-2332, CVE-2026-10050, CVE-2026-5795,
                  CVE-2025-11143, and CVE-2026-6790. Excluding removes the vulnerable code from
                  the artifact set entirely, which is stronger than a suppression for code we
                  don't run.
                -->
                <exclusion>
                    <groupId>org.eclipse.jetty</groupId>
                    <artifactId>jetty-webapp</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty</groupId>
                    <artifactId>jetty-servlet</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-core</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <!--
                  hadoop 3.5 drops the legacy javax.xml.bind:jaxb-api transitive
                  that jackson-module-jaxb-annotations needs. We don't use JAXB
                  annotations, so excluding the Jackson module entirely is cleaner
                  than dragging the legacy javax.xml.bind API back onto a Jakarta
                  EE 10 classpath.
                -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.module</groupId>
                    <artifactId>jackson-module-jaxb-annotations</artifactId>
                </exclusion>
                <!--
                  jline: pulled in (compile scope) via hadoop-yarn-client, which uses it for
                  interactive YARN CLI tools (e.g. the "yarn top" shell). Muninn never invokes
                  YARN CLI classes — hadoop-mapreduce-client-core is used only for the
                  InputFormat/OutputFormat type surface Parquet/Iceberg compile against — so
                  this code path is dead on our classpath. The resolved version (3.9.0, 2019)
                  needs 3.30.14+ to fix CVE-2026-56740 / CVE-2026-56741, and 3.25.0+ for
                  CVE-2023-50572; rather than gamble on a 3.9 -> 3.30 API jump being binary
                  compatible with Hadoop's compiled-against-3.9 bytecode for a feature we never
                  use, exclude it outright.
                -->
                <exclusion>
                    <groupId>org.jline</groupId>
                    <artifactId>jline</artifactId>
                </exclusion>
                <!--
                  2026-09-11 (post-merge follow-up, verified against a real dependency-check
                  run, GH Actions run 34651381704): websocket-client / websocket-common /
                  websocket-api come from the SAME hadoop-yarn-client branch as jline above,
                  on the SAME EOL Jetty 9.4.58.v20250814 build (no patched 9.4.x release
                  exists — see the jetty-webapp/jetty-servlet exclusion on hadoop-common for
                  the full EOL argument). Same reachability argument as jline: this is
                  Hadoop's YARN CLI/web-socket-based log-following support, which Muninn never
                  invokes. websocket-client and websocket-common each carry CVE-2026-2332,
                  CVE-2026-10050, CVE-2026-5795, CVE-2025-11143, CVE-2026-6790; websocket-api
                  has none flagged today but is excluded too since it's the same dead branch.
                -->
                <exclusion>
                    <groupId>org.eclipse.jetty.websocket</groupId>
                    <artifactId>websocket-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty.websocket</groupId>
                    <artifactId>websocket-common</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty.websocket</groupId>
                    <artifactId>websocket-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MinIO / S3 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Spring Boot 4.0 extracted Flyway auto-configuration out of
             spring-boot-autoconfigure into this dedicated module. Without it,
             migrations silently do not run on startup. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4.0 extracted TestRestTemplate into spring-boot-resttestclient;
             spring-boot-starter-test no longer brings it in transitively. It in turn
             needs RestTemplateBuilder from the extracted spring-boot-restclient module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot ServiceConnection support for Testcontainers -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: architectural rule enforcement -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                    <argLine>
                        @{argLine}
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.math=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <groups>integration</groups>
                    <!--
                      Project convention: integration tests are named
                      *IntegrationTest.java (more readable than the default *IT).
                      The default Failsafe patterns are kept so *IT.java still works.
                    -->
                    <includes>
                        <include>**/IT*.java</include>
                        <include>**/*IT.java</include>
                        <include>**/*ITCase.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                    <!--
                      Fork-per-test so each integration test gets a fresh JVM.
                      Tests start their own Testcontainers and set system
                      properties for the bootstrap address; sharing a JVM would
                      leak one test's container address into the next.
                    -->
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                  Pinning groupId/artifactId/version here (rather than letting the Security
                  workflow's ad-hoc `org.owasp:dependency-check-maven:check` invocation
                  resolve whatever is newest at run time) makes the scan reproducible, and
                  means this <configuration> — in particular the suppression file — is picked
                  up even though the workflow never passes -DsuppressionFile itself. See
                  dependency-check-suppressions.xml for the reasoned, dated entries.
                -->
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!--
                                  Bundle floor: regression guard at today's unit-test baseline.
                                  Integration tests (run separately in CI) push real coverage higher.
                                  Ratchet up as more code is exercised by unit tests.
                                -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.25</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  Determinism-critical: pure-function computation code.
                                  Per CODING_STANDARDS.md §Coverage and
                                  PERFORMANCE_BUDGETS.md §Coverage Budgets — target 100%.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.muninn.feature.compute</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  shared.time (UUIDv7): foundational utility, exercised by
                                  many tests. Should stay above 90%.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.muninn.shared.time</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <haltOnFailure>true</haltOnFailure>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
